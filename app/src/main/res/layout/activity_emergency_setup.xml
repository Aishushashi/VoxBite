<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Setup"
            android:textColor="#FF6600"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Say 'emergency' or 'bachao' to activate SOS"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="28dp" />

        <!-- Your name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR NAME"
            android:textColor="#FF6600"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="e.g. Priya"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="16sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="24dp" />

        <!-- Contact 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY CONTACT 1"
            android:textColor="#FF6600"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etContact1Name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Name (e.g. Amma)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="16sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etContact1Phone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Phone number (e.g. 9876543210)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="16sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="phone"
            android:layout_marginBottom="24dp" />

        <!-- Contact 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY CONTACT 2"
            android:textColor="#FF6600"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etContact2Name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Name (e.g. Appa)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="16sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etContact2Phone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Phone number (e.g. 9876543210)"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="16sp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="phone"
            android:layout_marginBottom="32dp" />

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveContacts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Emergency Contacts"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6600"
            android:layout_marginBottom="16dp" />

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D0D0D"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What happens when you say emergency?"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Your GPS location is fetched"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. SMS sent to both contacts with Maps link"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Google Maps opens showing nearest hospital"
                android:textColor="#888888"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>